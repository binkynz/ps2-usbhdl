#!/bin/sh
# Build a tiny PS2 ISO containing the hello-world test ELF, for fast
# iteration on the streaming/install code (USB-1.1 streams a ~120 KB
# ISO in under a second, vs. ~67 minutes for a real DVD).
#
# Output: dist/test.iso, ready to drop on the USB at mass:/test.iso.
set -eu

repo_root=$(cd "$(dirname "$0")/.." && pwd)
image=ps2-usbhdl-build:latest

docker build -q \
	-t "$image" \
	-f "$repo_root/scripts/Dockerfile" \
	"$repo_root/scripts" >/dev/null

mkdir -p "$repo_root/dist"

docker run --rm -i \
	-v "$repo_root:/src" \
	-w /src \
	-u "$(id -u):$(id -g)" \
	"$image" \
	sh -eu <<'IN_CONTAINER'
out=/tmp/iso_root
rm -rf "$out"
mkdir -p "$out"

# Compile the test ELF directly to BOOT.ELF in the staging dir.
mips64r5900el-ps2-elf-gcc \
	-D_EE -G0 -O2 -Wall -gdwarf-2 -gz \
	-I"$PS2SDK"/ee/include -I"$PS2SDK"/common/include \
	-T"$PS2SDK"/ee/startup/linkfile \
	-L"$PS2SDK"/ee/lib \
	-Wl,-zmax-page-size=128 \
	test/main.c -o "$out/BOOT.ELF" -ldebug

# SYSTEM.CNF tells the PS2 BIOS / OPL which ELF on the disc is the
# entry point. ;1 is the ISO9660 file-version suffix; backslash is
# the Sony-PS2 path separator. Both are required for boot.
printf 'BOOT2 = cdrom0:\\BOOT.ELF;1\nVER = 1.00\nVMODE = NTSC\n' \
	> "$out/SYSTEM.CNF"

# -iso-level 1 enforces strict 8.3 names which is the most
# conservative thing PS2 BIOS will accept. -V sets the ISO9660
# Volume Identifier (visible in our PVD parse) and -quiet keeps the
# tool from chatting to stderr on success.
genisoimage -quiet -iso-level 1 -V USBHDL_TEST \
	-o /src/dist/test.iso "$out"
IN_CONTAINER

ls -la "$repo_root/dist/test.iso"
echo
echo "Drop dist/test.iso onto the USB at mass:/test.iso."
echo "If only test.iso is present (no other .iso files), the installer"
echo "will pick it up automatically."
