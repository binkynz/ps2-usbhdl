#!/bin/sh
# Pre-commit hook: refuse to commit if any staged C source/header
# isn't clang-format-clean. Install with `just install-hooks`.
set -e

# Only inspect what's actually about to be committed, and only the
# C files. We let renames/copies through (the file content matters,
# not the rename mechanics).
files=$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '\.(c|h)$' || true)

if [ -z "$files" ]; then
	exit 0
fi

if ! echo "$files" | xargs clang-format --dry-run --Werror 2>&1; then
	echo
	echo "pre-commit: clang-format issues above. fix with: just fmt"
	exit 1
fi
