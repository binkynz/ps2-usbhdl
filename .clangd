# clangd LSP config. Companion to compile_flags.txt at the repo
# root — that file holds the include paths and defines (it's the
# right place for path-based flags because clangd resolves paths
# in compile_flags.txt relative to its own directory, whereas
# CompileFlags.Add in .clangd resolves paths relative to the
# *source file's* directory which is wrong for include trees that
# live at the project root).
#
# This file just tunes diagnostics.

Diagnostics:
  Suppress:
    # PS2SDK headers use GCC-specific attributes that clang treats
    # as unknown but that don't affect diagnostic value.
    - unknown-attributes
